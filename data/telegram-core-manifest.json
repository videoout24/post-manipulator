  "telegramCore": {
    "storage": {
      "engine": "bot-scoped IndexedDB",
      "databaseName": "post-manipulator-bot-<botId>",
      "stores": [
        "settings",
        "bindings",
        "runtime",
        "topics",
        "preview",
        "gallery",
        "thumbnail_cache",
        "projects",
        "messages"
      ],
      "botIdentityStore": "bindings/botIdentity"
    },
    "runtime": {
      "transport": "getUpdates long polling",
      "offsetStore": "runtime/telegramOffset",
      "acceptedOwnerMedia": [
        "photo",
        "video",
        "audio",
        "voice",
        "document"
      ],
      "ignoredByDefault": [
        "text",
        "video_note",
        "sticker",
        "animation",
        "location",
        "contact",
        "poll",
        "dice"
      ]
    },
    "owner": {
      "binding": "t.me deep-link /start token",
      "singleOwner": true,
      "foreignUsers": "ignored"
    },
    "editorPreview": {
      "systemTopic": "Предпросмотр",
      "selfHealing": true,
      "messageStrategy": "edit existing; recreate message if missing; recreate topic if thread is invalid"
    },
    "projectPreviewChannel": {
      "slots": 1,
      "type": "private channel",
      "binding": "my_chat_member discovery + random channel_post confirmation code",
      "requiredRights": [
        "post_messages",
        "edit_messages",
        "delete_messages"
      ],
      "discoveryWhenSlotFilled": false
    },
    "publicApi": {
      "editor": [
        "telegramCore.editor.preview.schedule",
        "telegramCore.editor.preview.sync",
        "telegramCore.editor.preview.setEnabled"
      ],
      "project": [
        "telegramCore.project.previewChannel.render",
        "telegramCore.project.previewChannel.send",
        "telegramCore.project.previewChannel.edit",
        "telegramCore.project.previewChannel.deleteMessage"
      ],
      "gallery": [
        "telegramCore.media.onReceived",
        "telegramCore.topics.onObserved",
        "telegramCore.topics.create",
        "telegramCore.topics.rename"
      ]
    },
    "credentials": {
      "tokenStore": "Telegram.WebApp.CloudStorage/rmb_token_v2/AES-GCM",
      "cloudIdentityMetadata": "none",
      "identityStore": "bindings/botIdentity",
      "rotationCheck": "getMe(newToken).id === stored botIdentity.id",
      "preserves": [
        "owner binding",
        "preview topic",
        "preview channel",
        "gallery",
        "topics",
        "runtime offset"
      ]
    },
    "securityGate": {
      "mode": "client-only",
      "allowedPlatforms": ["tdesktop"],
      "launcherBotId": "resolved by getMe after token decryption",
      "publisherBotMode": "same",
      "maxInitDataAgeSec": 900,
      "telegramUserIdentityStore": "bindings/miniAppUserIdentity",
      "publisherBotIdentityStore": "bindings/botIdentity",
      "tokenStore": "Telegram.WebApp.CloudStorage/rmb_token_v2/AES-GCM",
      "cloudIdentityMetadata": "none",
      "databaseEncrypted": false
    }
  },
  "gallery": {
    "assetIdentity": "random asset_<type>_<uuid>",
    "stores": {
      "metadata": "gallery",
      "topics": "topics/gallery:<threadId>",
      "thumbnails": "thumbnail_cache"
    },
    "originalMediaStoredLocally": false,
    "duplicateHint": "telegram.fileUniqueId",
    "idempotencyKey": "sourceEventKey = chatId:messageId",
    "thumbnailCache": {
      "type": "browser HTTP cache + in-memory getFile URL cache",
      "persistentBlobCache": false,
      "urlTtlMinutes": 50,
      "sourceOfTruth": "thumbnailFileId"
    },
    "sourceDelete": "optional; only after metadata persistence",
    "filters": [
      "type",
      "topic",
      "no-topic",
      "search"
    ],
    "acceptedTypes": [
      "photo",
      "video",
      "audio",
      "voice",
      "document"
    ],
    "editorIntegration": {
      "blockTypes": {
        "photo": [
          "photo"
        ],
        "video": [
          "video"
        ],
        "audio": [
          "audio"
        ],
        "voice_note": [
          "voice"
        ],
        "collage": [
          "photo",
          "video"
        ],
        "slideshow": [
          "photo",
          "video"
        ]
      },
      "blockSnapshotFields": [
        "galleryId",
        "fileId",
        "caption"
      ],
      "fileIdReadOnly": true,
      "dragAndDrop": true,
      "canvasPreview": true,
      "documentAssets": "gallery-only; Telegram Rich Messages have no InputRichBlockDocument",
      "collectionAssignment": "Gallery photo/video → auto-created child Photo/Video RichBlock",
      "collectionSelection": "container remains selected after asset add"
    }
  },
  "uiLayout": {
    "store": "settings/ui.layout.preferences",
    "editor": [
      "editorLeft"
    ],
    "gallery": [
      "galleryLeft",
      "galleryRight"
    ]
  }
